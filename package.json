{
  "name": "solarpro-global",
  "version": "1.6.0",
  "private": true,
  "description": "SolarPro Global — solar installation website template",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.min.css --minify",
    "build": "npm run build:css && node scripts/build-dist.js",
    "check": "node guardrails/run.js",
    "package": "npm run build:css && npm run check && node guardrails/package.js",
    "check:themeforest": "node guardrails/run.js --suite=themeforest",
    "package:themeforest": "npm run build:css && node scripts/package-themeforest.js"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "tailwindcss": "^3.4.17"
  }
}
